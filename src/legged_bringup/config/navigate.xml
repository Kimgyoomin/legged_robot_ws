<!-- Halt tracking on failure, then retry the same goal after 1 wall-clock second.
     At most 30 retries per goal (not a 30-second total deadline).
     Delay is built into BehaviorTree.CPP; no Wait action server is required.
     This does not erase obstacles or generate backup/spin motions. -->
<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <RecoveryNode name="RetryTemporaryBlockage" number_of_retries="30">
      <PipelineSequence name="ReplanAndTrack">
        <RateController hz="1.0">
          <ComputePathToPose goal="{goal}" path="{path}" planner_id="Height"/>
        </RateController>
        <FollowPath path="{path}" controller_id="FollowPath"/>
      </PipelineSequence>
      <Delay delay_msec="1000">
        <AlwaysSuccess/>
      </Delay>
    </RecoveryNode>
  </BehaviorTree>
</root>
