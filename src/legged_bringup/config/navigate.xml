<!-- Replan at 1 Hz; FollowPath is halted on planning failure. No automatic backup off the height route. -->
<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <PipelineSequence name="ReplanAndTrack">
      <RateController hz="1.0">
        <ComputePathToPose goal="{goal}" path="{path}" planner_id="Height"/>
      </RateController>
      <FollowPath path="{path}" controller_id="FollowPath"/>
    </PipelineSequence>
  </BehaviorTree>
</root>
