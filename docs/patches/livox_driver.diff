diff --git a/src/comm/pub_handler.cpp b/src/comm/pub_handler.cpp
index e33d588..44d7091 100644
--- a/src/comm/pub_handler.cpp
+++ b/src/comm/pub_handler.cpp
@@ -28,6 +28,7 @@
 #include <chrono>
 #include <iostream>
 #include <limits>
+#include "imu_rotation.hpp"
 
 namespace livox_ros {
 
@@ -122,6 +123,20 @@ void PubHandler::OnLivoxLidarPointCloudCallback(uint32_t handle, const uint8_t d
       imu_data.acc_x = imu->acc_x;
       imu_data.acc_y = imu->acc_y;
       imu_data.acc_z = imu->acc_z;
+      // Use this sensor's configured rotation even if its first cloud has not
+      // arrived. Translation never applies to IMU vectors. Do not hold the
+      // packet lock while invoking a publisher callback.
+      ExtParameter rotation;
+      {
+        std::lock_guard<std::mutex> lock(self->packet_mutex_);
+        uint32_t id = 0;
+        GetLidarId(LidarProtoType::kLivoxLidarType, handle, id);
+        const auto it = self->lidar_extrinsics_.find(id);
+        if (it == self->lidar_extrinsics_.end()) {return;}
+        rotation = it->second.param;
+      }
+      rotate_imu(rotation.roll, rotation.pitch, rotation.yaw, imu_data);
+
       self->imu_callback_(&imu_data, self->imu_client_data_);
     }
     return;
